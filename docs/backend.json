
{
  "entities": {
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a group or flat within the NourishTrack application, enabling shared meal and expense tracking.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the group entity." },
        "groupName": { "type": "string", "description": "The name of the group or flat." },
        "invitationCode": { "type": "string", "description": "Unique code used for users to join the group." },
        "adminId": { "type": "string", "description": "Reference to User who is the administrator of the group." }
      },
      "required": ["id", "groupName", "invitationCode", "adminId"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the NourishTrack application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user entity." },
        "email": { "type": "string", "description": "The user's email address.", "format": "email" },
        "displayName": { "type": "string", "description": "The user's display name." },
        "groupId": { "type": ["string", "null"], "description": "Reference to Group that the user belongs to." },
        "isAdmin": { "type": "boolean", "description": "Indicates whether the user is an administrator of a group." }
      },
      "required": ["id", "email"]
    },
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a member within a group, containing their email and role.",
      "properties": {
        "email": { "type": "string", "description": "The member's email address.", "format": "email" },
        "role": { "type": "string", "description": "The role of the member within the group (e.g., 'admin', 'member')." },
        "joinedAt": { "type": "string", "description": "The timestamp when the member joined the group.", "format": "date-time" }
      },
      "required": ["email", "role", "joinedAt"]
    },
    "MealLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MealLog",
      "type": "object",
      "description": "Represents a meal log entry for a user.",
      "properties": {
        "id": { "type": "string" }, "groupId": { "type": "string" }, "userId": { "type": "string" }, "userName": { "type": "string" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "mealType", "date", "description", "createdAt"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents a shared expense incurred for the group.",
      "properties": {
        "id": { "type": "string" }, "groupId": { "type": "string" }, "userId": { "type": "string" }, "userName": { "type": "string" },
        "description": { "type": "string" }, "amount": { "type": "number" }, "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string", "enum": ["Food", "Electricity", "Gas", "Other"] },
        "receiptPhotoUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "description", "amount", "date", "category", "createdAt"]
    },
    "PurchasedItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchasedItem",
      "type": "object",
      "description": "Represents a specific item purchased for the group.",
      "properties": {
        "id": { "type": "string" }, "groupId": { "type": "string" }, "userId": { "type": "string" }, "userName": { "type": "string" },
        "name": { "type": "string" }, "quantity": { "type": "number" }, "unit": { "type": "string" }, "cost": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }, "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "name", "quantity", "unit", "cost", "date", "createdAt"]
    }
  },
  "auth": { "providers": ["password", "google"] },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User", "schema": { "$ref": "#/entities/User" },
          "rules": { "read, write": "request.auth.uid == userId" },
          "description": "Stores user profile information. Users can only access their own document."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group", "schema": { "$ref": "#/entities/Group" },
          "rules": {
            "read": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true"
          },
          "description": "Stores group information. Readable by members, writable by admins."
        }
      },
      {
        "path": "/groups/{groupId}/members/{memberId}",
        "definition": {
          "entityName": "Member", "schema": { "$ref": "#/entities/Member" },
          "rules": {
            "read": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true"
          },
          "description": "Stores basic info about group members. Readable by members, writable by admins."
        }
      },
      {
        "path": "/groups/{groupId}/meals/{mealId}",
        "definition": {
          "entityName": "MealLog", "schema": { "$ref": "#/entities/MealLog" },
          "rules": { "read, write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId" },
          "description": "Stores meal logs. Accessible only by members of the group."
        }
      },
      {
        "path": "/groups/{groupId}/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense", "schema": { "$ref": "#/entities/Expense" },
          "rules": { "read, write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId" },
          "description": "Stores expense entries. Accessible only by members of the group."
        }
      },
      {
        "path": "/groups/{groupId}/purchasedItems/{itemId}",
        "definition": {
          "entityName": "PurchasedItem", "schema": { "$ref": "#/entities/PurchasedItem" },
          "rules": { "read, write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId" },
          "description": "Stores purchased items. Accessible only by members of the group."
        }
      }
    ],
    "reasoning": "This structure enforces security by scoping all group-related data (meals, expenses, items, members) within a group's subcollections. Security rules consistently use `get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId` to verify that the requesting user is a member of the group they are trying to access, preventing unauthorized data access. Admin-only write permissions are applied to sensitive documents like the group details and member list."
  }
}
