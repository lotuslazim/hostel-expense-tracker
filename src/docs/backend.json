
{
  "entities": {
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a group or flat within the NourishTrack application, enabling shared meal and expense tracking.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the group entity." },
        "groupName": { "type": "string", "description": "The name of the group or flat." },
        "invitationCode": { "type": "string", "description": "Unique code used for users to join the group." },
        "adminId": { "type": "string", "description": "Reference to User who is the administrator of the group." }
      },
      "required": ["id", "groupName", "invitationCode", "adminId"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the NourishTrack application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user entity." },
        "email": { "type": "string", "description": "The user's email address.", "format": "email" },
        "displayName": { "type": "string", "description": "The user's display name." },
        "groupId": { "type": ["string", "null"], "description": "Reference to Group that the user belongs to." },
        "isAdmin": { "type": "boolean", "description": "Indicates whether the user is an administrator of a group." }
      },
      "required": ["id", "email"]
    },
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a member within a group, containing their email and role.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "description": "The member's email address.", "format": "email" },
        "displayName": { "type": "string", "description": "The user's display name." },
        "role": { "type": "string", "description": "The role of the member within the group (e.g., 'admin', 'member')." },
        "joinedAt": { "type": "string", "description": "The timestamp when the member joined the group.", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "role", "joinedAt"]
    },
    "MealLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MealLog",
      "type": "object",
      "description": "Represents a meal log entry for a user.",
      "properties": {
        "id": { "type": "string" }, "groupId": { "type": "string" }, "userId": { "type": "string" }, "userName": { "type": "string" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "mealNumber": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "userName", "mealType", "date", "description", "mealNumber", "createdAt"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents a shared expense incurred for the group. This includes both food purchases and utility bills.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the expense." }, 
        "groupId": { "type": "string", "description": "The ID of the group this expense belongs to." }, 
        "userId": { "type": "string", "description": "The ID of the user who logged the expense." }, 
        "userName": { "type": "string", "description": "The display name of the user who logged the expense." },
        "description": { "type": "string", "description": "A description of the expense (e.g., 'Groceries' or 'September Electricity Bill')." }, 
        "amount": { "type": "number", "description": "The total amount of the expense." }, 
        "date": { "type": "string", "format": "date-time", "description": "The date the expense was incurred." },
        "category": { "type": "string", "enum": ["Food & Groceries", "Electricity", "Gas", "Other"], "description": "The category of the expense." },
        "receiptPhotoUrl": { "type": "string", "format": "uri", "description": "An optional URL for a photo of the receipt." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the expense was logged." }
      },
      "required": ["id", "groupId", "userId", "userName", "description", "amount", "date", "category", "createdAt"]
    },
     "PurchasedItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchasedItem",
      "type": "object",
      "description": "Represents a specific food item purchased for the group.",
      "properties": {
        "id": { "type": "string" }, "groupId": { "type": "string" }, "userId": { "type": "string" }, "userName": { "type": "string" },
        "name": { "type": "string", "description": "Name of the item (e.g., 'Rice', 'Olive Oil')." },
        "quantity": { "type": "number", "description": "Quantity of the item." },
        "unit": { "type": "string", "description": "Unit of measurement (e.g., 'kg', 'L', 'pcs')." },
        "cost": { "type": "number", "description": "Total cost of the item(s)." },
        "date": { "type": "string", "format": "date-time", "description": "The date the item was purchased." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "userName", "name", "quantity", "unit", "cost", "date", "createdAt"]
    },
    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "Represents a chat message within a group.",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "userId", "userName", "createdAt"]
    }
  },
  "auth": { "providers": ["password", "google"] },
  "storage": {
    "rules": {
      "chatImages/{groupId}/{imageId}": {
        "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
        "write": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))"
      }
    },
    "reasoning": "Storage rules are set to allow any authenticated member of a group to read and write images to a `chatImages` folder that is scoped to their specific `groupId`. This prevents users from one group from accessing the images of another group."
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User", "schema": { "$ref": "#/entities/User" },
          "rules": { "read, write": "request.auth.uid == userId" },
          "description": "Stores user profile information. Users can only access their own document."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group", "schema": { "$ref": "#/entities/Group" },
          "rules": {
            "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true"
          },
          "description": "Stores group information. Readable by members, writable only by the group admin."
        }
      },
      {
        "path": "/groups/{groupId}/members/{memberId}",
        "definition": {
          "entityName": "Member", "schema": { "$ref": "#/entities/Member" },
          "rules": {
            "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true || request.auth.uid == memberId"
          },
          "description": "Stores basic info about group members. Readable by all members. Writable by admins or the member themselves."
        }
      },
      {
        "path": "/groups/{groupId}/meals/{mealId}",
        "definition": {
          "entityName": "MealLog", "schema": { "$ref": "#/entities/MealLog" },
          "rules": { 
            "list, read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "create": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && request.resource.data.userId == request.auth.uid",
            "update, delete": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && resource.data.userId == request.auth.uid"
          },
          "description": "Stores meal logs. Accessible only by members of the group. Users can only create/edit their own meals."
        }
      },
      {
        "path": "/groups/{groupId}/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense", "schema": { "$ref": "#/entities/Expense" },
          "rules": {
            "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "create": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && request.resource.data.userId == request.auth.uid",
            "update, delete": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && resource.data.userId == request.auth.uid"
          },
          "description": "Stores all expense entries. Accessible only by members of the group. Users can only create/edit their own expenses."
        }
      },
       {
        "path": "/groups/{groupId}/purchasedItems/{itemId}",
        "definition": {
          "entityName": "PurchasedItem", "schema": { "$ref": "#/entities/PurchasedItem" },
          "rules": {
            "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "create": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && request.resource.data.userId == request.auth.uid",
            "update, delete": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && resource.data.userId == request.auth.uid"
          },
          "description": "Stores detailed food item purchases. Accessible by members. Users can only create/edit their own items."
        }
      },
      {
        "path": "/groups/{groupId}/messages/{messageId}",
        "definition": {
          "entityName": "ChatMessage", "schema": { "$ref": "#/entities/ChatMessage" },
          "rules": {
            "list, read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))",
            "create": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) && request.resource.data.userId == request.auth.uid"
          },
          "description": "Stores chat messages. Accessible only by members of the group. Users can only create their own messages."
        }
      }
    ],
    "reasoning": "This structure enforces security by scoping all group-related data within a group's subcollections. The rule `exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))` is used consistently to verify that the requesting user is a member of the group they are trying to access. This is a secure and scalable pattern that prevents unauthorized data access. Write access is also based on group membership, with more restrictive admin-only writes on the core group document. Firestore's default-deny policy ensures any path not explicitly granted access is automatically blocked."
  }
}
