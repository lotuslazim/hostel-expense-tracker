
{
  "entities": {
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a group or flat within the NourishTrack application, enabling shared meal and expense tracking.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the group entity." },
        "name": { "type": "string", "description": "The name of the group or flat." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the group was created." },
        "adminId": { "type": "string", "description": "The ID of the user who created the group." }
      },
      "required": ["id", "name", "createdAt", "adminId"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the NourishTrack application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user entity." },
        "email": { "type": "string", "description": "The user's email address.", "format": "email" },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL of the user's profile picture." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "The role of the user."}
      },
      "required": ["id", "email"]
    },
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a member within a group, containing their email and role.",
      "properties": {
        "id": { "type": "string", "description": "The document ID, same as the user's UID." },
        "name": { "type": "string" },
        "email": { "type": "string", "description": "The member's email address.", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "The role of the member within the group." },
        "joinedAt": { "type": "string", "description": "The timestamp when the member joined the group.", "format": "date-time" },
        "groupId": { "type": "string", "description": "The ID of the group the member belongs to." },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "The status of the member." }
      },
      "required": ["id", "name", "email", "role", "joinedAt", "groupId", "status"]
    },
    "Meal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Meal",
      "type": "object",
      "description": "Represents a meal log entry for a user.",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner"] },
        "items": { "type": "array", "items": { "type": "string"} },
        "quantity": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "groupId": { "type": "string" }
      },
      "required": ["id", "memberId", "mealType", "date", "createdAt", "groupId"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents a shared expense incurred for the group.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the expense." }, 
        "amount": { "type": "number", "description": "The total amount of the expense." },
        "category": { "type": "string", "description": "The category of the expense." },
        "description": { "type": "string", "description": "A description of the expense." },
        "date": { "type": "string", "format": "date-time", "description": "The date the expense was incurred." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the expense was logged." },
        "groupId": { "type": "string", "description": "The ID of the group this expense belongs to." }, 
        "adminId": { "type": "string", "description": "The ID of the admin who logged the expense." }
      },
      "required": ["id", "amount", "category", "date", "createdAt", "groupId", "adminId"]
    },
    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "Represents a chat message within a group.",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "groupId": { "type": "string" }
      },
      "required": ["id", "senderId", "content", "createdAt", "groupId"]
    },
    "PurchasedItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchasedItem",
      "type": "object",
      "description": "Represents a single purchase of an item.",
      "properties": {
        "id": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalCost": { "type": "number" },
        "purchasedAt": { "type": "string", "format": "date-time" },
        "groupId": { "type": "string" },
        "adminId": { "type": "string" }
      },
      "required": ["id", "itemName", "quantity", "unitPrice", "totalCost", "purchasedAt", "groupId", "adminId"]
    }
  },
  "auth": { "providers": ["password", "google"] },
  "storage": {
    "rules": {
      "profilePictures/{userId}": {
        "read": "allow read",
        "write": "allow write: if request.auth != null && request.auth.uid == userId;"
      },
      "groupImages/{groupId}/{imageId}": {
        "read": "allow read: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
        "write": "allow write: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));"
      }
    },
    "reasoning": "Storage rules are set to allow any member of a group to read and write images to folders scoped to their `groupId`. Profile pictures are public to read but can only be written by the owner."
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User", "schema": { "$ref": "#/entities/User" },
          "rules": {
            "read": "allow read;",
            "list": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';",
            "write": "request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Stores user profiles. Admins can list and write to any user document. Users can only write to their own."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group", "schema": { "$ref": "#/entities/Group" },
          "rules": {
            "read": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "list": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';",
            "create": "request.auth.uid != null;",
            "update, delete": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Stores group information. Readable by members. Listable and modifiable only by admins. Any authenticated user can create a group."
        }
      },
      {
        "path": "/groups/{groupId}/members/{memberId}",
        "definition": {
          "entityName": "Member", "schema": { "$ref": "#/entities/Member" },
          "rules": {
            "read, list": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Stores group member info. Readable by any group member, but only writable by an admin."
        }
      },
      {
        "path": "/groups/{groupId}/meals/{mealId}",
        "definition": {
          "entityName": "Meal", "schema": { "$ref": "#/entities/Meal" },
          "rules": {
            "read, list": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "create": "request.resource.data.memberId == request.auth.uid;",
            "update, delete": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Meal logs. Readable by members. Members can only create their own meals. Only admins can update/delete."
        }
      },
      {
        "path": "/groups/{groupId}/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense", "schema": { "$ref": "#/entities/Expense" },
          "rules": {
            "read, list": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Expense logs. Readable by members, but only writable by an admin."
        }
      },
      {
        "path": "/groups/{groupId}/messages/{messageId}",
        "definition": {
          "entityName": "ChatMessage", "schema": { "$ref": "#/entities/ChatMessage" },
          "rules": {
            "read, list": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "create": "request.resource.data.senderId == request.auth.uid;"
          },
          "description": "Chat messages. Readable by members. Members can only create messages as themselves."
        }
      },
      {
        "path": "/groups/{groupId}/purchasedItems/{itemId}",
        "definition": {
          "entityName": "PurchasedItem", "schema": { "$ref": "#/entities/PurchasedItem" },
          "rules": {
            "read, list": "exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));",
            "write": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
          },
          "description": "Purchase records. Readable by members, but only writable by an admin."
        }
      }
    ],
    "reasoning": "This structure enforces security by scoping all group-related data within a group's subcollections. The rule `exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))` verifies that a user is a member of the group they are trying to access. The global `users` collection has a `role` field ('admin' or 'user'). This role is checked for all write operations on sensitive or group-wide collections, ensuring only admins can modify critical data. Regular users have more limited permissions, such as only being able to create their own meals or messages. This provides a clear and secure role-based access control system."
  }
}
