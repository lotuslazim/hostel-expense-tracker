service firebase.storage {
  match /b/{bucket}/o {
    // Rules for profile pictures
    match /profilePictures/{userId}/{fileName} {
      // Anyone can read profile pictures
      allow read;
      // Only the authenticated user can write to their own profile picture path
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 2 * 1024 * 1024 // Max 2MB
                    && request.resource.contentType.matches('image/.*');
    }

    // Rules for group-specific images (chat and receipts)
    match /groups/{groupId}/{imageType}/{fileName} where imageType in ['chatImages', 'receipts'] {
      // A user can read a file if they are a member of that group
      allow read: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      // A user can write a file if they are a member of that group
      allow write: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                     && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                     && request.resource.contentType.matches('image/.*');
    }
  }
}
