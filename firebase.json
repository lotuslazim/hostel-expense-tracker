
{
  "storage": {
    "rules": "src/firebase/storage.rules"
  },
  "hosting": [
    {
      "target": "bachelorbite",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
